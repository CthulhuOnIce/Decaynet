# ---------------------------------------------------------------------------
# Decaynet configuration. Copy to .env and fill in.
# Site name, region, map, sign-ups, tips and captcha are set in the app at
# /admin/settings, not here.
# ---------------------------------------------------------------------------

# === All-in-one stack (docker-compose.yml, Supabase included) ==============
# Generate these four with:
#   docker run --rm ghcr.io/cthulhuonice/decaynet:latest generate-secrets >> .env
#   (or node docker/generate-secrets.mjs >> .env, or open docs/generate-secrets.html)
# POSTGRES_PASSWORD=
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=

# Public URLs. Browsers reach both, so use real hostnames in production
# (e.g. https://history.example.org and https://api.history.example.org).
ORIGIN=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000

# 1 = load the Gary, Indiana demo on first start; 0 = start an empty site
SEED=0

# First admin (optional). Set both to create the admin on first start;
# otherwise open /setup and enter the code printed in the app's logs.
# ADMIN_EMAIL=you@example.org
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Your Name
# SETUP_TOKEN=choose-your-own-setup-code

# Optional fallback for the GeoNames importer (normally set at /admin/settings → Secrets)
# GEONAMES_USERNAME=
# Optional: your own Nominatim (address search, street corners in the workbench) instead of
# nominatim.openstreetmap.org, e.g. https://nominatim.example.org/search
# NOMINATIM_URL=

# Optional email (confirmations, password resets, magic links). Without SMTP,
# new accounts are confirmed immediately.
# MAILER_AUTOCONFIRM=false
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=history@example.org
# SMTP_SENDER_NAME=Decaynet

# === External Supabase (docker-compose.external.yml, or `npm run dev`) =====
# Supabase project URL and anon key as browsers reach them.
# Local dev: printed by `npx supabase start`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: needed for anonymous tips and user emails in /admin/users.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: how the server reaches Supabase if different from the public URL.
SUPABASE_INTERNAL_URL=
# Postgres connection string for the migration runner.
DATABASE_URL=
