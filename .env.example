# ---------------------------------------------------------------------------
# Decaynet configuration. Copy to .env and fill in.
# Most site behaviour (name, map defaults, sign-ups, tips, captcha) is set in
# the app at /admin/settings, not here.
# ---------------------------------------------------------------------------

# Supabase project URL and anon key, as browsers will reach them.
# Local dev: printed by `npx supabase start`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed for anonymous tips (captcha check, IP recording, private
# image upload) and for showing user emails in /admin/users. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: how the *server* reaches Supabase if different from the public URL.
# In Docker against a Supabase running on the host: http://host.docker.internal:54321
SUPABASE_INTERNAL_URL=

# --- Docker only ----------------------------------------------------------
# Public URL of this site (SvelteKit CSRF check).
ORIGIN=http://localhost:3000
# Postgres connection string for the migration runner
# (local `supabase start`: postgresql://postgres:postgres@host.docker.internal:54322/postgres)
DATABASE_URL=
# Set to 1 to load the Gary demo data on an empty database.
SEED=0
