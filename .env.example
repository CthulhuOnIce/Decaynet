# From `supabase status` (local) or your project's API settings (hosted)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed for anonymous tips (captcha check, IP recording, private
# image upload) and for showing user emails in /admin/users. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
